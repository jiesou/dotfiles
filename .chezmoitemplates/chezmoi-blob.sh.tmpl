{{ $secrets := include ".chezmoitemplates/chezmoi-blob-secrets.yaml.asc" | decrypt | fromYaml -}}
chezmoi_blob_s3_base_url="{{ $secrets.S3_BASE_URL }}"
chezmoi_blob_s3_bucket="{{ $secrets.S3_BUCKET }}"
chezmoi_blob_s3_access_key_id="{{ $secrets.S3_ACCESS_KEY_ID }}"
chezmoi_blob_s3_secret_access_key="{{ $secrets.S3_SECRET_ACCESS_KEY }}"

chezmoi_blob_usage() {
  echo "usage: chezmoi_blob put <local-file> <remote-key> [content-type]" >&2
  echo "       chezmoi_blob get <remote-key> <output-file>" >&2
  return 1
}

chezmoi_blob_json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

chezmoi_blob_json_get() {
  printf '%s' "$chezmoi_blob_json" | sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p"
}

chezmoi_blob() {
  op=${1-}

  case "$op" in
    put)
      local_file=${2-}
      remote_key=${3-}
      [ -f "$local_file" ] || { echo "chezmoi-blob: missing file $local_file" >&2; return 1; }

      # Get presigned URL for uploading
      body=$(printf '{"operation":"put_object","bucket":"%s","key":"%s","contentType":"%s"}' \
        "$(chezmoi_blob_json_escape "$chezmoi_blob_s3_bucket")" \
        "$(chezmoi_blob_json_escape "$remote_key")" \
        "$(chezmoi_blob_json_escape "${4-application/octet-stream}")")
      chezmoi_blob_json=$(curl -fsSL -X POST \
        -H "content-type: application/json" \
        -H "x-s3-access-key-id: $chezmoi_blob_s3_access_key_id" \
        -H "x-s3-secret-access-key: $chezmoi_blob_s3_secret_access_key" \
        --data-binary "$body" \
        "$chezmoi_blob_s3_base_url/api/s3/presign")
      chezmoi_blob_json=$(printf '%s' "$chezmoi_blob_json" | tr -d '\n')

      # Forward upload request directly to Storage
      upload_url=$(printf '%s' "$chezmoi_blob_json" | sed -n 's/.*"upload":{"url":"\([^"]*\)".*/\1/p')
      upload_headers=$(printf '%s' "$chezmoi_blob_json" | sed -n 's/.*"headers":{\([^}]*\)}.*/\1/p')
      [ -n "$upload_url" ] && [ -n "$upload_headers" ] || { echo "chezmoi-blob: invalid presign response" >&2; return 1; }
      printf '%s' "$upload_headers" |
        tr ',' '\n' |
        sed 's/^"//; s/"$//; s/":"\(.*\)$/\: \1/; s/^/header = "/; s/$/"/' |
        curl -fsSL -X PUT -K - --data-binary @"$local_file" "$upload_url" >/dev/null
      echo "  chezmoi-blob: uploaded to $(chezmoi_blob_json_get publicUrl)"
      ;;
    get)
      remote_key=${2-}
      local_file=${3-}

      # Get public download URL for downloading
      # body=$(printf '{"operation":"get_object","bucket":"%s","key":"%s"}' \
        # "$(chezmoi_blob_json_escape "$chezmoi_blob_s3_bucket")" \
        # "$(chezmoi_blob_json_escape "$remote_key")")
      # chezmoi_blob_json=$(curl -fsSL -X POST \
        # -H "content-type: application/json" \
        # -H "x-s3-access-key-id: $chezmoi_blob_s3_access_key_id" \
        # -H "x-s3-secret-access-key: $chezmoi_blob_s3_secret_access_key" \
        # --data-binary "$body" \
        # "$chezmoi_blob_s3_base_url/api/s3/presign")
      # chezmoi_blob_json=$(printf '%s' "$chezmoi_blob_json" | tr -d '\n')

      # # Download file directly from Storage
      # download_url=$(printf '%s' "$chezmoi_blob_json" | sed -n 's/.*"download":{"url":"\([^"]*\)".*/\1/p')
      # [ -n "$download_url" ] || { echo "chezmoi-blob: invalid presign response" >&2; return 1; }

      # Quicker for fixed pattern url
      download_url="https://jwtlxyh8eujeksex.public.blob.vercel-storage.com/bucket/$remote_key"
      curl -fsSL "$download_url" -o "$local_file"
      echo "  chezmoi-blob: downloaded from $(chezmoi_blob_json_get publicUrl)"
      ;;
    *)
      chezmoi_blob_usage
      ;;
  esac
}
