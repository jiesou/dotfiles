{{- $in_termux := env "TERMUX__PREFIX" | not | not -}}
{{- $target_path := joinPath .chezmoi.homeDir ".var/app/org.fcitx.Fcitx5/data/fcitx5/rime/sync" -}}
{{- if $in_termux -}}
  {{- $target_path = "/storage/emulated/0/Android/data/org.fcitx.fcitx5.android/files/data/rime/sync" -}}
{{- end -}}
{{- $encrypted_tar_file := joinPath .chezmoi.sourceDir "fcitx5-rime-sync.tar.asc" -}}
#!/bin/sh
set -eu

# run on this change: {{ output "sh" "-c" (printf "if [ -f %q ]; then git hash-object %q; else printf missing; fi" $encrypted_tar_file $encrypted_tar_file)}}

if ! git lfs version >/dev/null 2>&1; then
  echo "pull-fcitx5-rime-sync: git-lfs not available, skip" >&2
  exit 0
fi

TARGET_PATH={{ printf "%q" $target_path }}
ENCRYPTED_TAR_FILE={{ printf "%q" $encrypted_tar_file }}

if [ ! -f "$ENCRYPTED_TAR_FILE" ]; then
  echo "pull-fcitx5-rime-sync: fcitx5-rime-sync.tar.asc is in Git LFS, but git-lfs not available, skip" >&2
  exit 0
fi

TMP_TAR_FILE="$(mktemp)"
trap 'rm -f "$TMP_TAR_FILE"' EXIT HUP INT TERM

chezmoi decrypt --output "$TMP_TAR_FILE" "$ENCRYPTED_TAR_FILE"
{{- if not $in_termux }}
tar -x -f "$TMP_TAR_FILE" -C "$TARGET_PATH"
{{- else }}
sudo tar -x -f "$TMP_TAR_FILE" -C "$TARGET_PATH"
sudo chown -R u0_a884:ext_data_rw "$TARGET_PATH"
{{- end }}
echo "pull-fcitx5-rime-sync: finished!"
