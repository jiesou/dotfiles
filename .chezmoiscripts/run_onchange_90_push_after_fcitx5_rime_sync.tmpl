{{- $in_termux := env "TERMUX__PREFIX" | not | not -}}
{{- $target_path := joinPath .chezmoi.homeDir ".var/app/org.fcitx.Fcitx5/data/fcitx5/rime/sync" -}}
{{- if $in_termux -}}
  {{- $target_path = "/storage/emulated/0/Android/data/org.fcitx.fcitx5.android/files/data/rime/sync" -}}
{{- end -}}
{{- $trigger_hash_cmd := printf "find %q -type f -print0 | sort -z | xargs -0 cat" $target_path -}}
{{- $trigger_hash := "" -}}
{{- if $in_termux -}}
  {{- $trigger_hash = output "sudo" "sh" "-c" $trigger_hash_cmd | sha256sum -}}
{{- else -}}
  {{- $trigger_hash = output "sh" "-c" $trigger_hash_cmd | sha256sum -}}
{{- end -}}
#!/bin/sh
set -eu
# run on this change: {{ $trigger_hash }}

TRIGGER_HASH={{ printf "%q" $trigger_hash }}
TARGET_PATH={{ printf "%q" $target_path }}
TMP_TAR_FILE="$(mktemp)"
TMP_ENCRYPTED_TAR_FILE="$(mktemp)"
TMP_TRIGGER_HASH_FILE="$(mktemp)"
{{ template "chezmoi-blob.sh.tmpl" . }}
trap 'rm -f "$TMP_TAR_FILE" "$TMP_ENCRYPTED_TAR_FILE" "$TMP_TRIGGER_HASH_FILE"' EXIT HUP INT TERM

{{- if not $in_termux }}
tar -c -f "$TMP_TAR_FILE" -C "$TARGET_PATH" .
{{- else }}
sudo tar -c -f "$TMP_TAR_FILE" -C "$TARGET_PATH" .
{{- end }}
chezmoi encrypt --output "$TMP_ENCRYPTED_TAR_FILE" "$TMP_TAR_FILE"

# Push to chezmoi-blob
REMOTE_KEY=fcitx5-rime-sync.tar.asc
chezmoi_blob \
  put \
  "$TMP_ENCRYPTED_TAR_FILE" \
  "$REMOTE_KEY"
echo "$TRIGGER_HASH" > "$TMP_TRIGGER_HASH_FILE"
TRIGGER_HASH_FILE_REMOTE_KEY="$REMOTE_KEY.hash"
chezmoi_blob \
  put \
  "$TMP_TRIGGER_HASH_FILE" \
  "$TRIGGER_HASH_FILE_REMOTE_KEY" \
  text/plain

echo "push-fcitx5-rime-sync: finished!"
