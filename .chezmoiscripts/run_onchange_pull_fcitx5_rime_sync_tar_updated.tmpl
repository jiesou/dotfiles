#!/bin/sh
{{ $termux := includeTemplate "termux.yaml.tmpl" . | fromYaml }}
{{ $fcitx5_rime_sync := includeTemplate "fcitx5-rime-sync.yaml.tmpl" . | fromYaml }}
set -eu
# run on this change: {{ output "sh" "-c" "curl -fsSL 'https://JWtlXYH8eujeKSEx.public.blob.vercel-storage.com/bucket/fcitx5-rime-sync.tar.asc.hash' || true" }}

TARGET_PATH={{ printf "%q" $fcitx5_rime_sync.target_path }}
if ! {{ $termux.cmd_prefix }} [ -d "$TARGET_PATH" ]; then
    echo "pull-fcitx5-rime-sync: target path does not exist, skip"
    exit 0
fi

TMP_TAR_FILE="$(mktemp)"
TMP_ENCRYPTED_TAR_FILE="$(mktemp)"
{{ template "chezmoi-blob.sh.tmpl" . }}
trap 'rm -f "$TMP_TAR_FILE" "$TMP_ENCRYPTED_TAR_FILE"' EXIT HUP INT TERM

echo "pull-fcitx5-rime-sync: triggered, pulling..."
# pull from chezmoi-blob
REMOTE_KEY=fcitx5-rime-sync.tar.asc
chezmoi_blob \
  get \
  "$REMOTE_KEY" \
  "$TMP_ENCRYPTED_TAR_FILE" \
|| { echo "pull-fcitx5-rime-sync: failed to pull file from chezmoi-blob, skip"; exit 0; }

chezmoi decrypt --output "$TMP_TAR_FILE" "$TMP_ENCRYPTED_TAR_FILE"
{{ $termux.cmd_prefix }} tar -x -f "$TMP_TAR_FILE" -C "$TARGET_PATH"
{{- if $termux.in_termux }}
sudo chown -R u0_a884:ext_data_rw "$TARGET_PATH"
{{- end }}

# after pull, mark push script as "done", so it wont override local next time
_push_tmpl={{ joinPath .chezmoi.sourceDir ".chezmoiscripts" "run_onchange_push_fcitx5_rime_sync.tmpl" | quote }}
_push_hash=$(chezmoi execute-template < "$_push_tmpl" | sha256sum | awk '{print $1}')

_push_key={{ joinPath .chezmoi.homeDir ".chezmoiscripts" "push_fcitx5_rime_sync_tar_updated" | quote }}
_push_value="{\"type\":\"script\",\"contentsSHA256\":\"$_push_hash\"}"
printf '%s\n' \
  "pull-fcitx5-rime-sync: mark push script as 'done'" \
  "  new hash: $_push_hash"
(
  for _i in $(seq 1 30); do
    if chezmoi state set \
        --bucket entryState \
        --key "$_push_key" \
        --value "$_push_value" 2>/dev/null; then
      break
    fi
    sleep 0.3
  done
) >/dev/null 2>&1 < /dev/null &

echo "pull-fcitx5-rime-sync: finished!"
