#!/bin/sh
{{ $termux := includeTemplate "termux.yaml.tmpl" . | fromYaml }}
{{- $target_path := joinPath .chezmoi.homeDir ".var/app/org.fcitx.Fcitx5/data/fcitx5/rime/sync" }}
{{- if $termux.in_termux }}
  {{- $target_path = "/storage/emulated/0/Android/data/org.fcitx.fcitx5.android/files/data/rime/sync" }}
{{- end }}
set -eu

TARGET_PATH={{ printf "%q" $target_path }}
STATE_FILE="$CHEZMOI_SOURCE_DIR/.chezmoitemplates/fcitx5-rime-sync.trigger_state_hash.local"
REMOTE_KEY="fcitx5-rime-sync.tar.asc"
REMOTE_HASH_KEY="$REMOTE_KEY.hash"

read_file() {
  file=${1-}
  [ -f "$file" ] || return 0
  cat "$file"
}

if ! {{ $termux.cmd_prefix }}[ -d "$TARGET_PATH" ]; then
  echo "fcitx5-rime-sync: target path does not exist, skip"
  exit 0
fi

TMP_TAR_FILE="$(mktemp)"
TMP_ENCRYPTED_TAR_FILE="$(mktemp)"
TMP_REMOTE_HASH_FILE="$(mktemp)"
{{ includeTemplate "chezmoi-blob.sh.tmpl" . }}
trap 'rm -f "$TMP_TAR_FILE" "$TMP_ENCRYPTED_TAR_FILE" "$TMP_REMOTE_HASH_FILE"' EXIT HUP INT TERM

state_hash=$(read_file "$STATE_FILE")
remote_hash=""
if chezmoi_blob get "$REMOTE_HASH_KEY" "$TMP_REMOTE_HASH_FILE" >/dev/null 2>&1; then
  remote_hash=$(read_file "$TMP_REMOTE_HASH_FILE")
fi

if [ -n "$remote_hash" ] && [ "$remote_hash" != "$state_hash" ]; then
  echo "fcitx5-rime-sync: pulling..."
  chezmoi_blob get "$REMOTE_KEY" "$TMP_ENCRYPTED_TAR_FILE"
  chezmoi decrypt --output "$TMP_TAR_FILE" "$TMP_ENCRYPTED_TAR_FILE"
  {{ $termux.cmd_prefix }}tar -x -f "$TMP_TAR_FILE" -C "$TARGET_PATH"
  {{ if $termux.in_termux -}}
    sudo chown -R u0_a884:ext_data_rw "$TARGET_PATH"
  {{- end }}

  printf '%s\n' "$remote_hash" > "$STATE_FILE"
  echo "fcitx5-rime-sync: pulled"
  exit 0
fi

local_hash=$({{ $termux.cmd_prefix }}sh -ceu 'find "$1" -type f -exec sha256sum {} + 2>/dev/null | LC_ALL=C sort | sha256sum | awk "{print \$1}"' sh "$TARGET_PATH")
if [ "$local_hash" != "$state_hash" ]; then
  echo "fcitx5-rime-sync: pushing..."
  {{ $termux.cmd_prefix }}tar -c -f "$TMP_TAR_FILE" -C "$TARGET_PATH" .
  chezmoi encrypt --output "$TMP_ENCRYPTED_TAR_FILE" "$TMP_TAR_FILE"
  printf '%s\n' "$local_hash" > "$TMP_REMOTE_HASH_FILE"
  chezmoi_blob put "$TMP_ENCRYPTED_TAR_FILE" "$REMOTE_KEY"
  chezmoi_blob put "$TMP_REMOTE_HASH_FILE" "$REMOTE_HASH_KEY"
  
  printf '%s\n' "$local_hash" > "$STATE_FILE"
  echo "fcitx5-rime-sync: pushed"
  exit 0
fi

echo "fcitx5-rime-sync: already up to date"
