#!/bin/sh
{{ $termux := includeTemplate "termux.yaml.tmpl" . | fromYaml }}
{{- $target_path := joinPath .chezmoi.homeDir ".var/app/org.fcitx.Fcitx5/data/fcitx5/rime" }}
{{- if $termux.in_termux }}
  {{- $target_path = "/storage/emulated/0/Android/data/org.fcitx.fcitx5.android/files/data/rime" }}
{{- end }}
set -eu

TARGET_PATH={{ printf "%q" $target_path }}
TARGET_SYNC_PATH="$TARGET_PATH/sync"
TARGET_INSTALL_YAML_PATH="$TARGET_PATH/installation.yaml"
STATE_FILE="$CHEZMOI_SOURCE_DIR/.chezmoitemplates/fcitx5-rime-sync.trigger_state_hash"
STATE_REMOTE_FILE="$STATE_FILE.remote.local"
STATE_DEVICE_FILE="$STATE_FILE.device.local"
REMOTE_KEY="fcitx5-rime-sync.tar.asc"
REMOTE_HASH_KEY="$REMOTE_KEY.hash"

HASH_COMMAND='find "$1" -type f -exec sha256sum {} + | LC_ALL=C sort | sha256sum | awk "{print \$1}"'
read_file() {
  file=${1-}
  [ -f "$file" ] || return 0
  cat "$file"
}

if ! {{ $termux.cmd_prefix }}[ -d "$TARGET_PATH" ]; then
  echo "fcitx5-rime-sync: target path does not exist, skip sync"
  exit 0
fi

TMP_TAR_FILE="$(mktemp)"
TMP_ENCRYPTED_TAR_FILE="$(mktemp)"
TMP_REMOTE_HASH_FILE="$(mktemp)"
{{ includeTemplate "chezmoi-blob.sh.tmpl" . }}
trap 'rm -f "$TMP_TAR_FILE" "$TMP_ENCRYPTED_TAR_FILE" "$TMP_REMOTE_HASH_FILE"' EXIT HUP INT TERM

(
# prevent `chezmoi decrypt` gpg obtaining tty, cause hang
set -m
trap 'kill -TERM $$ 2>/dev/null' EXIT

state_remote_hash=$(read_file "$STATE_REMOTE_FILE")
state_device_hash=$(read_file "$STATE_DEVICE_FILE")
installation_id=$({{ $termux.cmd_prefix }}awk -F'"' '/installation_id/{print $2; exit}' "$TARGET_INSTALL_YAML_PATH")

echo "fcitx5-rime-sync: $installation_id fetching... (press Enter to skip)" >&2

remote_hash=""
if chezmoi_blob get "$REMOTE_HASH_KEY" "$TMP_REMOTE_HASH_FILE" >/dev/null 2>&1; then
  remote_hash=$(read_file "$TMP_REMOTE_HASH_FILE")
fi

# --- pull: apply remote changes except our own device directory ---
if [ -n "$remote_hash" ] && [ "$remote_hash" != "$state_remote_hash" ]; then
  echo "fcitx5-rime-sync: pulling..."
  chezmoi_blob get "$REMOTE_KEY" "$TMP_ENCRYPTED_TAR_FILE"
  chezmoi decrypt --output "$TMP_TAR_FILE" "$TMP_ENCRYPTED_TAR_FILE"
  {{ $termux.cmd_prefix }}tar -x --exclude="$installation_id" -f "$TMP_TAR_FILE" -C "$TARGET_SYNC_PATH"
  {{ if $termux.in_termux -}}
    sudo chown -R u0_a884:ext_data_rw "$TARGET_SYNC_PATH"
  {{- end }}

  printf '%s\n' "$remote_hash" > "$STATE_REMOTE_FILE"
  echo "fcitx5-rime-sync: pulled"
fi

# --- push: upload only if our device directory changed ---
echo "fcitx5-rime-sync: checking..."
latest_state_device_hash=$({{ $termux.cmd_prefix }} sh -c "$HASH_COMMAND" -- "$TARGET_SYNC_PATH/$installation_id")
if [ "$latest_state_device_hash" != "$state_device_hash" ]; then
  echo "fcitx5-rime-sync: pushing..."
  {{ $termux.cmd_prefix }}tar -c -f "$TMP_TAR_FILE" -C "$TARGET_SYNC_PATH" .
  chezmoi encrypt --output "$TMP_ENCRYPTED_TAR_FILE" "$TMP_TAR_FILE"
  latest_state_remote_hash=$({{ $termux.cmd_prefix }} sh -c "$HASH_COMMAND" -- "$TARGET_SYNC_PATH")
  printf '%s\n' "$latest_state_remote_hash" > "$TMP_REMOTE_HASH_FILE"
  chezmoi_blob put "$TMP_ENCRYPTED_TAR_FILE" "$REMOTE_KEY" &
  PID1=$!
  chezmoi_blob put "$TMP_REMOTE_HASH_FILE" "$REMOTE_HASH_KEY" &
  PID2=$!
  wait $PID1 || exit 1
  wait $PID2 || exit 1

  printf '%s\n' "$latest_state_remote_hash" > "$STATE_REMOTE_FILE"
  printf '%s\n' "$latest_state_device_hash" > "$STATE_DEVICE_FILE"
  echo "fcitx5-rime-sync: pushed"
fi

echo "fcitx5-rime-sync: already up to date"
) &
JOB_PID=$!

# --- Press Enter to skip ---
if read -r _ </dev/tty 2>/dev/null; then
  echo "fcitx5-rime-sync: skipped" >&2
  kill "$JOB_PID"
fi
