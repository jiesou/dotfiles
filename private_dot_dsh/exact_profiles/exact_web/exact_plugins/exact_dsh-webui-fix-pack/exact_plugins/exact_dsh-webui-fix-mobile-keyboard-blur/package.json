{
  "name": "@jiesou/dsh-webui-fix-mobile-keyboard-blur",
  "version": "0.1.1",
  "type": "module",
  "description": "Blur the chat composer when dsh-mobile parks on the sidebar page; stops Android WebView from popping the IME back up after the keyboard was dismissed with the input still focused.",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-webui-fix-pack.git",
    "directory": "plugins/dsh-webui-fix-mobile-keyboard-blur"
  }
}
