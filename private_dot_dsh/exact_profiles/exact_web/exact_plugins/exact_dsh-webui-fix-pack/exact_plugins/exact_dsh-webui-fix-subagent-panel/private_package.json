{
  "name": "@jiesou/dsh-webui-fix-subagent-panel",
  "version": "0.3.0",
  "type": "module",
  "description": "Keep the DSH Web UI subagent catalog panel on-screen and tap-toggleable on mobile/touch: clamp the title-bar session tree to the viewport and toggle it on click (client-only plugin).",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-webui-fix-pack.git",
    "directory": "plugins/dsh-webui-fix-subagent-panel"
  }
}