{
  "name": "@jiesou/dsh-webui-fix-composer-focus-restore",
  "version": "0.1.2",
  "type": "module",
  "description": "Restore composer focus (textarea or Lexical contenteditable) after a popupSelect command (e.g. /models) closes; works around the upstream bindComposerFocus wiring gap.",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-webui-fix-pack.git",
    "directory": "plugins/dsh-webui-fix-composer-focus-restore"
  }
}
