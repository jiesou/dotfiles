{
  "name": "@jiesou/dsh-webui-fix-mobile-stats-line",
  "version": "0.2.1",
  "type": "module",
  "description": "Make the DSH Web UI stats line tooltip reachable on touch/coarse-pointer UIs: keep the bubble visible under dsh-mobile and toggle it per tap (client-only plugin).",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-webui-fix-pack.git",
    "directory": "plugins/dsh-webui-fix-mobile-stats-line"
  }
}
