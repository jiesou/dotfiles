{
  "name": "@jiesou/dsh-webui-fix-pwa",
  "version": "0.3.6",
  "type": "module",
  "description": "PWA mode fix for the DSH Web UI: a launcher-reachable session cookie, standalone display, manifest colours matching the resolved scheme, and the iOS standalone head tags upstream omits.",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-webui-fix-pack.git",
    "directory": "plugins/dsh-webui-fix-pwa"
  }
}
