{
  "name": "@jiesou/dsh-webui-fix-ime-multiline-commit",
  "version": "0.1.0",
  "type": "module",
  "description": "Keep every line when an input method commits multi-line text into the composer (fcitx5-vinput, dictation tools).",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-webui-fix-pack.git",
    "directory": "plugins/dsh-webui-fix-ime-multiline-commit"
  }
}
