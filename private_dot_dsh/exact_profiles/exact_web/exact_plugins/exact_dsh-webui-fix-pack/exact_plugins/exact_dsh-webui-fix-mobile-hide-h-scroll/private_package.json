{
  "name": "@jiesou/dsh-webui-fix-mobile-hide-h-scroll",
  "version": "0.1.0",
  "type": "module",
  "description": "Hide the horizontal scrollbar that @dsh-external/dsh-mobile can still show on mobile web views while swiping the sidebar/chat pager (client-only plugin).",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-webui-fix-pack.git",
    "directory": "plugins/dsh-webui-fix-mobile-hide-h-scroll"
  }
}