{
  "name": "dsh-sandbox-landlock",
  "version": "0.1.1",
  "type": "module",
  "description": "DSH bundle: Landlock-only process sandbox provider (no namespaces, uid view untouched).",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sandbox",
    "landlock"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-sandbox-landlock.git"
  },
  "homepage": "https://github.com/jiesou/dsh-sandbox-landlock#readme",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "linux"
      ]
    }
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "release": "pnpm version patch && git push --follow-tags"
  },
  "files": [
    "lib",
    "src",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/node-addon-system": "^0.1.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.2",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
