{
  "name": "@jiesou/dsh-nous-portal-free-provider",
  "version": "0.1.5",
  "description": "Nous Portal free-tier provider for dsh: Portal OAuth (device-code) agent-key lifecycle behind an OpenAI-compatible harness route",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./oauth": {
      "types": "./lib/oauth.d.ts",
      "default": "./lib/oauth.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": {
    "dsh-nous-login": "lib/cli.js"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && npm version patch && git push --follow-tags && npm publish"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "nous",
    "nous-portal",
    "hermes",
    "llm-provider",
    "dsh-bundle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-nous-portal-free-provider.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-authorization": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-authorization": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
