+/**
+ * Drop the pending input a fork inherited from the tail it cut away.
+ *
+ * The fork cut runs from the boundary `turn/end` forward to the next
+ * `turn/start`, so a child seeded that way can end on the `agent/inbox/spliced`
+ * insert that queued the discarded turn's own message. Rebuilt from the seed
+ * alone, that insert reads as input still awaiting its turn: the child then
+ * runs the pre-rewind message ahead of whatever the user sends next. A rewind
+ * child must start with an empty inbox - the whole point is that the discarded
+ * turn never happened.
+ * @param ctx - host context carrying the agent registry.
+ * @param sessionId - the freshly created child session.
+ */
+function discardInheritedInbox(ctx, sessionId) {
+    const agent = typeof ctx.agents?.get === 'function' ? ctx.agents.get(sessionId) : undefined;
+    const inbox = agent?.inbox;
+    if (inbox !== undefined && typeof inbox.clear === 'function' && inbox.hasPending === true) {
+        inbox.clear();
+    }
