{
  "name": "dsh-lan",
  "version": "0.1.0",
  "description": "LAN overlay + secure-context plugin for the DeepSeek Harness web UI",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.yml": "./cordis.yml",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
