{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_search_advanced_exa",
      "enabled": true
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "type": "local"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "plugin": [],
  "provider": {
    "qianfan": {
      "models": {
        "deepseek-v3.2": {
          "name": "DeepSeek-V3.2"
        },
        "glm-5": {
          "name": "GLM-5"
        },
        "kimi-k2.5": {
          "name": "Kimi-K2.5"
        },
        "minimax-m2.5": {
          "name": "MiniMax-M2.5"
        }
      },
      "name": "Baidu Qianfan",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://qianfan.baidubce.com/v2"
      }
    }
  }
}
