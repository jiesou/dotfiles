#!/bin/bash
set -eu

# Bidirectional mirror with metadata preserved by source-state as source of truth.
# Per dir: re-add (modifications, preserves encrypted_/exact_ source attrs)
#        + forget-orphan (deletions, renames)
#        + add-new (new files; plain add, subdirs lack exact_ prefix)
#        + chattr +exact --recursive (propagate exact_ prefix to new subdirs)
# Encrypted (.asc) files are compared by decrypted content before commit;
# re-encryption noise (random GPG salt/IV) does NOT produce a commit.

DIRS=(
  "$HOME/.agents"
  "$HOME/.config/nvim"
  "$HOME/.config/opencode"
  "$HOME/.ssh"
  "$HOME/.dsh/profiles"
  "$HOME/.dsh/.agent-presets"
  "$HOME/.dsh/AGENTS.md"
  "$HOME/.dsh/cordis.patch.yml"
  "$HOME/.dsh/settings.yaml"
  "$HOME/.dsh/.credentials.yaml"
)

D=(); for x in "${DIRS[@]}"; do [ -e "$x" ] && D+=("$x"); done

SRC=$(chezmoi source-path)

# Sync with remote first — handles force-push
git -C "$SRC" fetch origin
git -C "$SRC" reset --hard origin/main

CFG="$HOME/.config/chezmoi/chezmoi.toml"
cp "$CFG" "$CFG.bak.sync.$$"
trap 'mv "$CFG.bak.sync.$$" "$CFG"' EXIT
sed -i 's/autoCommit = true/autoCommit = false/; s/autoPush = true/autoPush = false/' "$CFG"
BASE=$(git -C "$SRC" rev-parse HEAD)

# Read GPG passphrase from chezmoi config for decryption
GPG_PASS=$(grep -oP '(?<=passphrase = ").*(?=")' "$CFG.bak.sync.$$")
GPG_ARGS=(--batch --passphrase "$GPG_PASS" --no-symkey-cache --quiet)

# Pre-compute decrypted SHA256 for all tracked .asc files
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"; mv "$CFG.bak.sync.$$" "$CFG"' EXIT
while IFS= read -r -d '' f; do
  rel="${f#$SRC/}"
  gpg "${GPG_ARGS[@]}" --decrypt "$f" 2>/dev/null | sha256sum | cut -d' ' -f1 > "$TMPDIR/${rel//\//_}.sha256" 2>/dev/null || true
done < <(find "$SRC" -name '*.asc' -type f -print0)

echo "→ mirror each DIR via re-add + forget-orphan + add-new"
for d in "${D[@]}"; do
  chezmoi re-add --recursive "$d" 2>/dev/null || true

  ORPHANS=() NEWS=()
  while IFS= read -r -d '' m; do
    [ -n "$m" ] && { [ -e "$HOME/$m" ] || ORPHANS+=("$HOME/$m"); }
  done < <(chezmoi managed -0 "$d" 2>/dev/null)
  while IFS= read -r f; do
    [ -n "$f" ] && NEWS+=("$HOME/$f")
  done < <(chezmoi unmanaged "$d" 2>/dev/null)

  [ ${#ORPHANS[@]} -gt 0 ] && chezmoi forget --force "${ORPHANS[@]}" 2>/dev/null || true
  [ ${#NEWS[@]}    -gt 0 ] && chezmoi add          "${NEWS[@]}"    2>/dev/null || true
  chezmoi chattr +exact --recursive "$d" 2>/dev/null || true
done

echo "→ single commit + push"
git -C "$SRC" add -A
if [ -n "$(git -C "$SRC" status --porcelain)" ]; then
  # Check whether changes are real or just asc re-encryption noise
  real_change=false
  while IFS= read -r file; do
    if [[ "$file" != *.asc ]]; then
      real_change=true; break
    fi
    new_hash=$(gpg "${GPG_ARGS[@]}" --decrypt "$SRC/$file" 2>/dev/null | sha256sum | cut -d' ' -f1 2>/dev/null || echo "ERR")
    old_hash=$(cat "$TMPDIR/${file//\//_}.sha256" 2>/dev/null || echo "MISSING")
    if [ "$new_hash" != "$old_hash" ]; then
      real_change=true; break
    fi
  done < <(git -C "$SRC" diff --cached --name-only)

  if $real_change; then
    [ -n "$BASE" ] && git -C "$SRC" reset --soft "$BASE"
    git -C "$SRC" commit -m "sync: $(date +%Y-%m-%dT%H:%M:%S)" >/dev/null
    git -C "$SRC" push >/dev/null
    echo "  $(git -C "$SRC" log --oneline -1)"
  else
    git -C "$SRC" reset --quiet HEAD
    echo "  nothing to sync (asc re-encryption only)"
  fi
else
  echo "  nothing to sync"
fi
